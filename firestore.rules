rules_version = '2';

// 이 프로젝트에는 이전까지 Firestore 보안 규칙이 전혀 버전관리되지 않았음.
// 클라이언트가 academyId로 서버 사이드 필터링 쿼리를 하더라도(services/api.ts의
// AuthService.getUsersByAcademy), 이 규칙 파일이 없으면 누구든 Firebase SDK로
// users 컬렉션 전체를 직접 읽어갈 수 있음 — 실제 접근 제어는 이 파일이 담당한다.
//
// 배포 방법: firebase deploy --only firestore:rules
// (firebase-tools 설치 및 `firebase use <project-id>` 로 프로젝트 연결 필요)

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 호출자 자신의 users 문서 (role/academyId 판단용)
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && callerProfile().role == 'ADMIN';
    }

    function isTeacherOfAcademy(academyId) {
      return isSignedIn()
        && callerProfile().role == 'TEACHER'
        && academyId != null
        && callerProfile().academyId == academyId;
    }

    // 원장(학원 관리자): 해당 학원 소속 + isAcademyAdmin 플래그
    function isDirectorOfAcademy(academyId) {
      return isTeacherOfAcademy(academyId) && callerProfile().isAcademyAdmin == true;
    }

    // --- users: 학생/선생님/관리자 프로필 ---
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isTeacherOfAcademy(resource.data.academyId)
      );
      // 본인 uid로만 최초 생성 가능 (가입 흐름)
      // ⚠️ role 에스컬레이션 차단: 가입으로는 STUDENT/TEACHER만 가능하며
      //    원장 플래그(isAcademyAdmin)도 스스로 부여할 수 없다. ADMIN은 관리자만 생성.
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role in ['STUDENT', 'TEACHER']
        && request.resource.data.get('isAcademyAdmin', false) != true;
      // 본인, 관리자, 또는 같은 학원의 원장(등록 과정 관리 등)만 수정 가능
      // 관리자가 아니면 role/isAcademyAdmin은 기존 값에서 바꿀 수 없다.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          (request.auth.uid == userId || isDirectorOfAcademy(resource.data.academyId))
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('isAcademyAdmin', false) == resource.data.get('isAcademyAdmin', false)
        )
      );
      allow delete: if isAdmin();
    }

    // --- academies: 가입 화면(로그인 전)에서 코드 검증에 필요하므로 공개 읽기 ---
    // 문서에는 학원명/지역/가입코드만 있고, 코드 자체가 배포용 값이라 민감도 낮음
    match /academies/{academyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- assets / curriculum_configs / learning_sessions: 콘텐츠, 관리자만 쓰기 ---
    match /assets/{assetId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /curriculum_configs/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /learning_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- test_sessions: 진단 세션 로그, 본인/관리자만 접근 ---
    // userId 필드는 반드시 Firebase auth uid로 저장 (클라이언트도 uid로 통일됨)
    match /test_sessions/{sessionId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- config: 관리자 설정 문서 ---
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- teacher_quality_checks: 교사 수업 품질 점검 (관리자가 작성, 본인 교사와 소속 학원 원장이 열람) ---
    match /teacher_quality_checks/{checkId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.teacherUid == request.auth.uid ||
        isDirectorOfAcademy(resource.data.academyId)
      );
      allow write: if isAdmin();
    }

    // --- writings: 학생 글 (본인 작성, AI 분석 결과는 본인이 저장, 교사가 확인 코멘트) ---
    match /writings/{writingId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid ||
        isTeacherOfAcademy(resource.data.academyId)
      );
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid ||
        isTeacherOfAcademy(resource.data.academyId)
      );
      allow delete: if isAdmin();
    }

    // --- reading_logs: 독서 이력 (학생 본인이 기록, 교사는 열람) ---
    match /reading_logs/{logId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid ||
        isTeacherOfAcademy(resource.data.academyId)
      );
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.studentUid == request.auth.uid);
    }

    // --- manuals: 가맹 운영 매뉴얼 (본사가 작성, 선생님/원장이 열람) ---
    match /manuals/{manualId} {
      allow read: if isSignedIn() && (isAdmin() || callerProfile().role == 'TEACHER');
      allow write: if isAdmin();
    }

    // --- consultation_requests: 학생/학부모의 상담 신청 ---
    match /consultation_requests/{requestId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isTeacherOfAcademy(resource.data.academyId) ||
        resource.data.studentUid == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || isTeacherOfAcademy(resource.data.academyId));
      allow delete: if isAdmin();
    }

    // 그 외 컬렉션은 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
